# Copy to .env if you need overrides. No keys are required for the synthetic demo.
PDE_HOST=127.0.0.1
PDE_PORT=8000
# Source mode: synthetic (default) | file
PDE_SOURCE=synthetic
# For PDE_SOURCE=file: a dataset directory under data/imports/ containing data.csv|data.parquet + manifest.json
PDE_FILE_DATASET=
# Optional, unused by default. Never commit real values.
# NSE_MCP_TOKEN=
